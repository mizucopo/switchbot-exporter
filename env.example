# SwitchBot API 認証情報（必須）
SWITCHBOT_API_TOKEN=your_switchbot_token
SWITCHBOT_API_SECRET=your_switchbot_secret

# サーバー設定（任意）
SERVER_PORT=9171

# キャッシュ設定（任意）
CACHE_DIR=/tmp/switchbot
CACHE_EXPIRE_SECOND=600
DELAY_SECOND=1
API_TIMEOUT_SECOND=30

# 通信設定（任意。proxy はプロセス環境に渡す）
# HTTPS_PROXY=http://proxy.example:8080
# NO_PROXY=localhost,127.0.0.1
# REQUESTS_CA_BUNDLE=/app/ca-bundle.pem
# CURL_CA_BUNDLE=/app/ca-bundle.pem

# Docker 関連（任意）
DOCKER_USERNAME=docker_hub_username
DOCKER_TOKEN=docker_hub_token
