{
  "version": {
    "scheme": "semver",
    "sources": [
      {
        "path": "Cargo.toml",
        "format": "toml",
        "key": ["package", "version"]
      }
    ],
    "locks": [
      { "path": "Cargo.lock", "format": "toml-lock", "package": "switchbot-exporter", "optional": true }
    ]
  },
  "publication": {
    "release_tag": "{version}",
    "github_release": true,

    "release_paths": ["Cargo.toml", "Dockerfile"],
    "rust": {
      "targets": [
        "x86_64-unknown-linux-gnu",
        "x86_64-pc-windows-msvc",
        "aarch64-pc-windows-msvc",
        "aarch64-apple-darwin"
      ],
      "smoke_args": ["--help"],
      "stage_command": []
    },
    "latest_image": "extended",
    "images": [
      {
        "name": "extended",
        "repository": "mizucopo/switchbot-exporter",
        "tag": "{version}",
        "aliases": ["latest"],
        "registry": "dockerhub"
      }
    ]
  }
}
