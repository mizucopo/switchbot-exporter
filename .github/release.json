{
  "version": {
    "scheme": "semver",
    "sources": [
      {
        "path": "Cargo.toml",
        "format": "toml",
        "key": ["package", "version"]
      }
    ],
    "locks": [
      { "path": "Cargo.lock", "format": "toml-lock", "package": "switchbot-exporter", "optional": true }
    ]
  },
  "publication": {
    "release_tag": "{version}",
    "github_release": true,

    "release_paths": ["Cargo.toml", "Dockerfile"],
    "latest_image": "extended",
    "images": [
      {
        "name": "extended",
        "repository": "mizucopo/switchbot-exporter",
        "tag": "{version}",
        "aliases": ["latest"],
        "registry": "dockerhub"
      }
    ]
  }
}
